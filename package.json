{
  "name": "timetracker-npm-import",
  "version": "1.0.11",
  "description": "",
  "main": "./lib/index.js",
  "bin": {
    "import-worklogs": "./lib/index.js"
  },
  "scripts": {
    "start": "node --watch --require ts-node/register src/index.ts",
    "create": "npm run build && npm run test:install",
    "build": "tsc -p .",
    "test": "node --no-experimental-strip-types --require ts-node/register --test test/*.test.ts",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install",
    "test:install": "npm i -g && import-worklogs"
  },
  "keywords": [
    "timetracker",
    "7pace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7pace/timetracker-npm-import"
  },
  "author": "7pace",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/7pace/timetracker-npm-import/issues"
  },
  "homepage": "https://github.com/7pace/timetracker-npm-import/blob/main/README.md",
  "dependencies": {
    "axios": "^1.20.0",
    "colors": "1.3.3",
    "commander": "3.0.1",
    "exceljs": "^4.4.0",
    "httpntlm": "^1.8.13",
    "inversify": "^6.2.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "underscore": "^1.13.8",
    "uuid": "^11.1.1"
  }
}
